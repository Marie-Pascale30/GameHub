# Copier en .env pour un lancement local (php -S). En Docker, passer ces valeurs avec -e.
APP_ENV=production
# Mode démo : affiche le lien de réinitialisation du mot de passe à l'écran (pas de SMTP).
APP_DEMO=1
# URL publique utilisée pour construire les liens (facultatif).
APP_URL=
# Derrière un proxy (Render…) : faire confiance à X-Forwarded-For / X-Forwarded-Proto.
# L’IP du client est la N-ième entrée de X-Forwarded-For en partant de la droite (Render : 3), voir README.
TRUST_PROXY=0
TRUSTED_PROXY_HOPS=3

# SQLite (par défaut)
DB_DRIVER=sqlite
DB_PATH=var/gamehub.sqlite

# MySQL / MariaDB
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=gamehub
# DB_USER=gamehub
# DB_PASS=
